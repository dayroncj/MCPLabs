{
	"name": "MCP Labs + C#",
	"build": {
		"dockerfile": "Dockerfile",
		"context": ".."
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-dotnettools.csdevkit", // Kit de desarrollo de C#
				"ms-dotnettools.csharp", // Soporte básico de C#
				"humao.rest-client", // Para probar peticiones JSON-RPC
				"visualstudioexptteam.vscodeintellicode" // IA para autocompletado
			],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash"
			}
		}
	},
	"forwardPorts": [
		5173,
		6274,
		6277 // Puertos usados por MCP Inspector
	],
	"postCreateCommand": "cd weather && dotnet restore",
	"remoteUser": "vscode"
}